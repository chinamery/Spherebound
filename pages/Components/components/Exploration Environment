import React, { useState, useEffect } from "react";
import CharacterController from "./CharacterController";

const spheres = [
  {
    name: "Biosphere",
    image: `${process.env.PUBLIC_URL}/assets/sphere-biosphere.png`
  },
  {
    name: "Atmosphere",
    image: `${process.env.PUBLIC_URL}/assets/sphere-atmosphere.png`
  },
  {
    name: "Geosphere",
    image: `${process.env.PUBLIC_URL}/assets/sphere-geosphere.png`
  },
  {
    name: "Hydrosphere",
    image: `${process.env.PUBLIC_URL}/assets/sphere-hydrosphere.png`
  }
];

function ExplorationEnvironment({ startingSphere, onBack }) {
  const foundStartingIndex = spheres.findIndex(
    (sphere) => sphere.name === startingSphere
  );
  const startingIndex = Math.max(0, foundStartingIndex);
  const [position, setPosition] = useState(startingIndex * 25 + 2);
  const currentIndex = Math.min(spheres.length - 1, Math.floor(position / 25));
  const currentSphere = spheres[currentIndex];
  const scrollOffset = Math.min(75, Math.max(0, position - 7.5));

  function moveCharacter(amount) {
    setPosition((previous) => Math.min(98.75, Math.max(0, previous + amount)));
  }

  useEffect(() => {
    function handleKeyDown(event) {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      const direction = event.key === "ArrowRight" ? 1 : -1;
      setPosition((previous) =>
        Math.min(98.75, Math.max(0, previous + direction * 2))
      );
    }

    window.addEventListener("keydown", handleKeyDown);

    return () => {
      window.removeEventListener("keydown", handleKeyDown);
    };
  }, []);

  return (
    <div className="exploration">
      <header className="game-header">
        <div className="game-brand">
          <span className="brand-icon" aria-hidden="true">S</span>
          <div>
            <p className="brand-eyebrow">SPHEREBOUND</p>
            <h2>Earth Explorer</h2>
          </div>
        </div>

        <div className="sphere-status" aria-live="polite">
          <div className="status-heading">
            <span className="status-label">NOW EXPLORING</span>
            <strong>{currentSphere.name}</strong>
          </div>
          <div
            className="sphere-progress"
            aria-label={`Sphere ${currentIndex + 1} of ${spheres.length}`}
          >
            {spheres.map((sphere, index) => (
              <span
                key={sphere.name}
                className={index <= currentIndex ? "progress-step active" : "progress-step"}
              />
            ))}
          </div>
          <span className="sphere-count">
            {String(currentIndex + 1).padStart(2, "0")} / 04
          </span>
        </div>

        <button className="home-button" type="button" onClick={onBack}>
          <span aria-hidden="true">⌂</span>
          <span>Home</span>
        </button>
      </header>

      <div className="viewport">
        <div
          className="world"
          style={{ transform: `translateX(-${scrollOffset}%)` }}
        >
          {spheres.map((sphere) => (
            <div className="panel" key={sphere.name}>
              <img src={sphere.image} alt={`${sphere.name} landscape`} />
            </div>
          ))}
          <CharacterController position={position} />
        </div>

        <div className="controls">
          <button
            className="move-button"
            aria-label="Move left"
            onClick={() => moveCharacter(-2)}
          >
            <span aria-hidden="true">←</span>
            <span className="control-label">MOVE LEFT</span>
          </button>
          <button
            className="move-button"
            aria-label="Move right"
            onClick={() => moveCharacter(2)}
          >
            <span className="control-label">MOVE RIGHT</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>

      </div>
    </div>
  );
}

export default ExplorationEnvironment;
