
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    padding: 30px;
}

.page-title {
    text-align: center;
    margin-bottom: 25px;
    font-size: 32px;
}

.profile-container {
    max-width: 900px;
    min-height: 350px;
    margin: auto;
    display: flex;
    background: white;
    border: 2px solid #333;
    border-radius: 20px;
    overflow: hidden;
}

.sidebar {
    width: 150px;
    border-right: 2px solid #333;
}

.profile-content {
    flex: 1;
    padding: 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.profile-header {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-bottom: 25px;
}

.profile-header img {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
}

.profile-header h2 {
    font-size: 28px;
}

.profile-buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.profile-buttons button {
    width: 280px;
    padding: 15px;
    margin: 8px;
    border: 2px solid #333;
    border-radius: 30px;
    background: white;
    font-size: 18px;
    cursor: pointer;
}

.profile-buttons button:hover {
    background: #333;
    color: white;
}

.back-btn {
    display: block;
    margin: 30px auto;
    padding: 12px 35px;
    border: 2px solid #333;
    border-radius: 25px;
    background: white;
    cursor: pointer;
}

.back-btn:hover {
    background: #333;
    color: white;
}

@media (max-width: 600px) {
    body {
        padding: 10px;
    }

    .sidebar {
        width: 50px;
    }

    .profile-content {
        padding: 20px 10px;
    }

    .profile-header {
        flex-direction: column;
        text-align: center;
    }

    .profile-buttons button {
        width: 100%;
    }
}

