
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    padding: 30px;
}

.container {
    max-width: 1000px;
    min-height: 500px;
    margin: auto;
    padding: 30px;
    background: white;
    border: 2px solid #333;
    border-radius: 15px;
}

header {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 40px;
}

header h1 {
    font-size: 30px;
}

.menu {
    position: absolute;
    left: 0;
    padding: 10px 15px;
    font-size: 22px;
    border: none;
    background: transparent;
    cursor: pointer;
}

.discovery-cards {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
}

.card {
    width: 220px;
    min-height: 210px;
    border: 2px solid #555;
    border-radius: 15px;
    overflow: hidden;
    text-align: center;
    cursor: pointer;
}

.card img {
    width: 100%;
    height: 110px;
    object-fit: cover;
}

.card h3 {
    margin: 10px;
}

.card p {
    padding: 10px;
    color: #666;
}

.card:hover {
    transform: translateY(-5px);
    transition: 0.3s;
}

.back-btn {
    display: block;
    margin: 35px auto 0;
    padding: 12px 35px;
    border: 2px solid #333;
    border-radius: 25px;
    background: white;
    font-weight: bold;
    cursor: pointer;
}

.back-btn:hover {
    background: #333;
    color: white;
}

@media (max-width: 600px) {
    body {
        padding: 10px;
    }

    .discovery-cards {
        flex-direction: column;
        align-items: center;
    }

    .card {
        width: 100%;
    }
}

